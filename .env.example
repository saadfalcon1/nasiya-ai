# Nusxa oling:  copy .env.example .env   (Windows)  /  cp .env.example .env
# .env faylini HECH QACHON GitHub'ga yuklamang!

# @BotFather bergan token
TELEGRAM_BOT_TOKEN=

# mock = kalitsiz sinov rejimi
# open = Meta ochiq vaznli model (Muse Spark Open) Baseten/Modal orqali  <- ASOSIY
# meta = Meta Model API (API kalit kerak)
AI_BACKEND=mock

# Fireworks (tavsiya):
LLM_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_API_KEY=
LLM_MODEL=accounts/fireworks/models/muse-spark-open
# Tezroq javob uchun (bo'sh = model standarti)
LLM_REASONING_EFFORT=low
# Ovoz -> matn (faqat Meta modellari): mms = Meta MMS serverda (o'zbek bor, ~2-4 GB RAM)
#   meta = Muse Voice Transcribe (MODEL_API_KEY; o'zbek yo'q) ; bo'sh = o'chiq
STT_BACKEND=mms
MMS_DTYPE=bfloat16
# Baseten bo'lsa: LLM_BASE_URL=https://inference.baseten.co/v1  LLM_MODEL=meta-models/muse-spark-open-1026

# dev.meta.ai -> API keys
MODEL_API_KEY=
MODEL_API_URL=https://api.meta.ai/v1/responses
MUSE_MODEL=muse-wonder-1.0

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

# SMS: console = faqat logga yozadi; eskiz = Eskiz.uz orqali haqiqiy SMS
SMS_BACKEND=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Telegram Mini App
BOT_USERNAME=NasiyaAIBot
WEBAPP_URL=
# Brauzerda (Telegram'siz) sinash uchun: o'z Telegram ID'ingiz. Serverda bo'sh qoldiring!
WEBAPP_DEV_USER=
CSRF_TRUSTED_ORIGINS=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
